<Window x:Class="DynoDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DYNOMAS - Universal Dynamometer Interface (WPF)"
        Width="1280" Height="740"
        MinWidth="1100" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        FontFamily="Segoe UI, Arial">

    <Window.Resources>
        <!-- Glow Effects -->
        <DropShadowEffect x:Key="CyanGlow" Color="#00F0FF" BlurRadius="25" ShadowDepth="0" Opacity="0.85"/>
        <DropShadowEffect x:Key="CyanSoftGlow" Color="#00F0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="RedGlow" Color="#FF2A2A" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="YellowGlow" Color="#FFE500" BlurRadius="15" ShadowDepth="0" Opacity="0.9"/>
        <DropShadowEffect x:Key="WhiteTextGlow" Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="OrangeGlow" Color="#FFAA00" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="GreenGlow" Color="#00FF88" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>

        <!-- Cyberpunk Sci-Fi Button Style -->
        <Style x:Key="SciFiButton" TargetType="Button">
            <Setter Property="Background" Value="#05080C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2D3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#66F7FF"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource CyanSoftGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00F0FF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Cyan Button Style -->
        <Style x:Key="ActiveCyanButton" TargetType="Button" BasedOn="{StaticResource SciFiButton}">
            <Setter Property="Background" Value="#00F0FF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Effect" Value="{StaticResource CyanSoftGlow}"/>
        </Style>

        <!-- Pill Button Style -->
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource SciFiButton}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1.2" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2D3A"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource CyanSoftGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dedicated Tare Orange Button Style -->
        <Style x:Key="TareButton" TargetType="Button" BasedOn="{StaticResource SciFiButton}">
            <Setter Property="BorderBrush" Value="#FFAA00"/>
            <Setter Property="Foreground" Value="#FFAA00"/>
            <Setter Property="Background" Value="#1E1300"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Effect" Value="{StaticResource OrangeGlow}"/>
        </Style>

        <!-- Dedicated Fan Green Button Style -->
        <Style x:Key="FanGreenButton" TargetType="Button" BasedOn="{StaticResource SciFiButton}">
            <Setter Property="BorderBrush" Value="#00FF88"/>
            <Setter Property="Foreground" Value="#00FF88"/>
            <Setter Property="Background" Value="#001F0E"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Effect" Value="{StaticResource GreenGlow}"/>
        </Style>

        <!-- Dedicated Run Pull Button Style -->
        <Style x:Key="RunPullButton" TargetType="Button" BasedOn="{StaticResource SciFiButton}">
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#002D3D"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Effect" Value="{StaticResource CyanSoftGlow}"/>
        </Style>
    </Window.Resources>

    <!-- Main Outer Grid -->
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>    <!-- Center Dials & Large Graph -->
            <RowDefinition Height="Auto"/> <!-- Bottom Deck -->
            <RowDefinition Height="Auto"/> <!-- Test Slider -->
        </Grid.RowDefinitions>

        <!-- ================= TOP BAR ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Setting Button -->
            <Button Grid.Column="0" Content="SETTING" Style="{StaticResource SciFiButton}" Width="90" Height="32"/>

            <!-- Top ENG HP Pill -->
            <StackPanel Grid.Column="1" Margin="25,0,0,0" HorizontalAlignment="Center">
                <TextBlock Text="ENG HP" Foreground="#FF3B3B" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                <Border BorderBrush="#FF3B3B" BorderThickness="1.5" CornerRadius="5" Background="#150808" Padding="14,2" Margin="0,2,0,0">
                    <TextBlock x:Name="TxtTopHp" Text="0.0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Center Logo -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="KZR" Foreground="#00F0FF" FontWeight="Black" FontSize="13"  HorizontalAlignment="Center" Effect="{StaticResource CyanSoftGlow}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
                    <TextBlock Text="DYNO" Foreground="#FF2222" FontWeight="Black" FontStyle="Italic" FontSize="26" Effect="{StaticResource RedGlow}"/>
                    <TextBlock Text="MAS" Foreground="#FFFFFF" FontWeight="Black" FontStyle="Italic" FontSize="26"/>
                </StackPanel>
                <TextBlock Text="DYNO TUNING MACHINE" Foreground="#FF2222" FontWeight="Bold" FontSize="8.5" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Top RPM DYNO Pill -->
            <StackPanel Grid.Column="3" Margin="0,0,25,0" HorizontalAlignment="Center">
                <TextBlock Text="RPM DYNO" Foreground="#FF3B3B" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                <Border BorderBrush="#FF3B3B" BorderThickness="1.5" CornerRadius="5" Background="#150808" Padding="14,2" Margin="0,2,0,0">
                    <TextBlock x:Name="TxtTopRpmDyno" Text="0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- On-Line Button -->
            <Button x:Name="BtnOnline" Grid.Column="4" Content="ON-LINE" Style="{StaticResource ActiveCyanButton}" Width="105" Height="32" Click="BtnOnline_Click" ToolTip="Click to check or reconnect COM4 status"/>
        </Grid>

        <!-- ================= CENTER MAIN AREA (TACHO LEFT | EXPANDED GRAPH CENTER | SPEEDO RIGHT) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/> <!-- Left: Prominent RPM Tachometer -->
                <ColumnDefinition Width="*"/>   <!-- Center: EXPANDED Dyno Power Curve Chart -->
                <ColumnDefinition Width="270"/> <!-- Right: Compact Speedometer & Aux Sensors -->
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT GAUGE (ENGINE RPM TACHOMETER) ================= -->
            <Grid Grid.Column="0" Width="330" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Outer Cyan Glowing Ring -->
                <Ellipse Width="326" Height="326" Stroke="#00F0FF" StrokeThickness="6.5" Effect="{StaticResource CyanGlow}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#001520" Offset="1"/>
                            <GradientStop Color="#020406" Offset="0.5"/>
                            <GradientStop Color="#000000" Offset="0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Metallic Chamfer -->
                <Ellipse Width="270" Height="270" Stroke="#2D3740" StrokeThickness="3.5"/>

                <!-- Canvas for Dial Ticks and Numbers -->
                <Canvas x:Name="CanvasRpmDial" Width="330" Height="330"/>

                <!-- Needle (WPF Vector Path with RotateTransform) -->
                <Canvas Width="330" Height="330">
                    <Path Data="M 163,165 L 164,30 L 166,30 L 167,165 Z" Fill="#FFE500" Effect="{StaticResource YellowGlow}">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="RpmNeedleTransform" Angle="0" CenterX="165" CenterY="165"/>
                        </Path.RenderTransform>
                    </Path>
                </Canvas>

                <!-- Center Carbon Fiber Hub (Layered ON TOP) -->
                <Grid Width="195" Height="195" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="195" Height="195" Stroke="#00F0FF" StrokeThickness="3">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1A1A1A" Offset="0"/>
                                <GradientStop Color="#0B0B0B" Offset="0.8"/>
                                <GradientStop Color="#000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Inner Digital Readout -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="DYNOMAS" Foreground="#FF2222" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" Effect="{StaticResource RedGlow}"/>
                        <TextBlock x:Name="TxtDigitalRpm" Text="0" Foreground="#FFFFFF" FontWeight="Black" FontSize="42" HorizontalAlignment="Center" Margin="0,1" Effect="{StaticResource WhiteTextGlow}"/>
                        <TextBlock Text="ENGINE" Foreground="#00F0FF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="- RPM -" Foreground="#70DFFF" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= CENTER SECTION: EXPANDED DYNO POWER CHART ================= -->
            <Grid Grid.Column="1" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Mini Telemetry: Torque, Max HP, Max Nm, Load -->
                    <RowDefinition Height="Auto"/> <!-- AFR 1 & AFR 2 -->
                    <RowDefinition Height="*"/>    <!-- Dominant Dyno Curve Chart -->
                    <RowDefinition Height="Auto"/> <!-- Shop Name Banner -->
                </Grid.RowDefinitions>

                <!-- 1. Mini Telemetry Row: TORQUE, MAX HP, MAX NM, LOAD -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#FF3B3B" BorderThickness="1.2" CornerRadius="5" Background="#120606" Padding="6,3" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ENG TORQ" Foreground="#FF3B3B" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTorq" Text="0.0" Foreground="#FFFFFF" FontWeight="Black" FontSize="17" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#FF3B3B" BorderThickness="1.2" CornerRadius="5" Background="#120606" Padding="6,3" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Hp MAX" Foreground="#FF3B3B" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtMaxHp" Text="0.0" Foreground="#FFFFFF" FontWeight="Black" FontSize="17" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#FF3B3B" BorderThickness="1.2" CornerRadius="5" Background="#120606" Padding="6,3" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Nm MAX" Foreground="#FF3B3B" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtMaxNm" Text="0.0" Foreground="#FFFFFF" FontWeight="Black" FontSize="17" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" BorderBrush="#FF3B3B" BorderThickness="1.2" CornerRadius="5" Background="#120606" Padding="6,3" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="LOAD" Foreground="#FF3B3B" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtLoad" Text="0" Foreground="#FFFFFF" FontWeight="Black" FontSize="17" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. AFR Row (Air-Fuel Ratio with Safety Glow) -->
                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- AFR 1 -->
                    <Border Grid.Column="0" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="5" Background="#05121A" Padding="8,3" Margin="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="AFR 1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Margin="10,0" Height="8" CornerRadius="4" Background="#111" BorderBrush="#333" BorderThickness="1">
                                <Border HorizontalAlignment="Left" Width="120" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00F0FF" Offset="0"/>
                                            <GradientStop Color="#00FF88" Offset="0.5"/>
                                            <GradientStop Color="#FF3B3B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <TextBlock x:Name="TxtAfr1" Grid.Column="2" Text="12.8" Foreground="#00FF88" FontWeight="Black" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- AFR 2 -->
                    <Border Grid.Column="1" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="5" Background="#05121A" Padding="8,3" Margin="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="AFR 2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Margin="10,0" Height="8" CornerRadius="4" Background="#111" BorderBrush="#333" BorderThickness="1">
                                <Border HorizontalAlignment="Left" Width="120" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00F0FF" Offset="0"/>
                                            <GradientStop Color="#00FF88" Offset="0.5"/>
                                            <GradientStop Color="#FF3B3B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <TextBlock x:Name="TxtAfr2" Grid.Column="2" Text="12.8" Foreground="#00FF88" FontWeight="Black" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. EXPANDED DYNO POWER CURVE CHART (Height 230px, with Axis Scale Numbers) -->
                <Border Grid.Row="2" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="8" Background="#03080E" MinHeight="220" Margin="0,2">
                    <Grid x:Name="ChartGrid" ClipToBounds="True">
                        <!-- Chart Legend & Title -->
                        <Grid VerticalAlignment="Top" Margin="10,6,10,0" Panel.ZIndex="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Border Width="12" Height="3" Background="#00F0FF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="HORSEPOWER (HP)" Foreground="#00F0FF" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center"/>
                                <Border Width="12" Height="3" Background="#FF3B3B" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                <TextBlock Text="TORQUE (Nm)" Foreground="#FF3B3B" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="RPM SPAN: 0 - 15,000" Foreground="#3A6677" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Canvas for Grid Lines & Axis Scales -->
                        <Canvas x:Name="CanvasChartScale" Panel.ZIndex="1"/>

                        <!-- Cyan Curve: Horsepower -->
                        <Polyline x:Name="PolylineHp" Stroke="#00F0FF" StrokeThickness="2.8" Effect="{StaticResource CyanSoftGlow}" Panel.ZIndex="3"/>
                        <!-- Red Curve: Torque -->
                        <Polyline x:Name="PolylineTorque" Stroke="#FF2A2A" StrokeThickness="2.8" Effect="{StaticResource RedGlow}" Panel.ZIndex="3"/>
                    </Grid>
                </Border>

                <!-- 4. Shop Branding Banner -->
                <TextBlock Grid.Row="3" Text="YOUR NAME HERE" Foreground="#FFFFFF" FontWeight="Black" FontSize="15" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </Grid>

            <!-- ================= RIGHT COLUMN: COMPACT SPEEDOMETER & AUX SENSORS ================= -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="260">
                <!-- Compact Speedometer Dial (240x240) -->
                <Grid Width="240" Height="240" HorizontalAlignment="Center">
                    <!-- Outer Cyan Glowing Ring -->
                    <Ellipse Width="236" Height="236" Stroke="#00F0FF" StrokeThickness="5" Effect="{StaticResource CyanGlow}">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#001520" Offset="1"/>
                                <GradientStop Color="#020406" Offset="0.5"/>
                                <GradientStop Color="#000000" Offset="0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Metallic Chamfer -->
                    <Ellipse Width="196" Height="196" Stroke="#2D3740" StrokeThickness="3"/>

                    <!-- Canvas for Speed Dial Ticks and Numbers -->
                    <Canvas x:Name="CanvasSpeedDial" Width="240" Height="240"/>

                    <!-- Needle -->
                    <Canvas Width="240" Height="240">
                        <Path Data="M 118,120 L 119,25 L 121,25 L 122,120 Z" Fill="#FFE500" Effect="{StaticResource YellowGlow}">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpeedNeedleTransform" Angle="0" CenterX="120" CenterY="120"/>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>

                    <!-- Center Carbon Fiber Hub (Layered ON TOP) -->
                    <Grid Width="142" Height="142" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="142" Height="142" Stroke="#00F0FF" StrokeThickness="2.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#1A1A1A" Offset="0"/>
                                    <GradientStop Color="#0B0B0B" Offset="0.8"/>
                                    <GradientStop Color="#000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Inner Text -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="DYNOMAS" Foreground="#FF2222" FontWeight="Black" FontSize="9.5" HorizontalAlignment="Center" Effect="{StaticResource RedGlow}"/>
                            <TextBlock x:Name="TxtDigitalSpeed" Text="0" Foreground="#FFFFFF" FontWeight="Black" FontSize="34" HorizontalAlignment="Center" Margin="0,1" Effect="{StaticResource WhiteTextGlow}"/>
                            <TextBlock Text="SPEED" Foreground="#00F0FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="- KM/H -" Foreground="#70DFFF" FontWeight="SemiBold" FontSize="8.5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Sensor Telemetry (Relocated Here to Free Up Space for the Huge Chart!) -->
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TPS % -->
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#FFD600" BorderThickness="1" CornerRadius="4" Background="#0F0D04" Padding="2,3" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TPS %" Foreground="#FFD600" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTps" Text="0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- TEMP °C -->
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#FFD600" BorderThickness="1" CornerRadius="4" Background="#0F0D04" Padding="2,3" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TEMP c" Foreground="#FFD600" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTemp" Text="46" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- IAT °C -->
                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="#FFD600" BorderThickness="1" CornerRadius="4" Background="#0F0D04" Padding="2,3" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="IAT c" Foreground="#FFD600" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtIat" Text="48" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- MAP kPa -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#FFD600" BorderThickness="1" CornerRadius="4" Background="#0F0D04" Padding="4,3" Margin="2">
                        <Grid>
                            <TextBlock Text="MAP kpa:" Foreground="#FFD600" FontWeight="Bold" FontSize="9.5" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                            <TextBlock x:Name="TxtMap" Text="57" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        </Grid>
                    </Border>

                    <!-- VOLT V -->
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#FFD600" BorderThickness="1" CornerRadius="4" Background="#0F0D04" Padding="2,3" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="VOLT V" Foreground="#FFD600" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtVolt" Text="13.4" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ================= BOTTOM CONTROL DECK (TOUCHSCREEN-FRIENDLY) ================= -->
        <Border Grid.Row="2" BorderBrush="#3300F0FF" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- DISPLAY -->
                    <ColumnDefinition Width="Auto"/> <!-- AUTO -->
                    <ColumnDefinition Width="Auto"/> <!-- RPM -->
                    <ColumnDefinition Width="*"/>    <!-- LOAD MODE -->
                    <ColumnDefinition Width="Auto"/> <!-- CMD GRID -->
                </Grid.ColumnDefinitions>

                <!-- Column 1: DISPLAY -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="DISPLAY" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <Button Content="INERTIA" Style="{StaticResource PillButton}" Margin="0,0,0,3"/>
                    <Button Content="LOADED" Style="{StaticResource ActiveCyanButton}" Margin="0,0,0,3"/>
                </StackPanel>

                <!-- Column 2: AUTO -->
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="AUTO" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <Button Content="TUNE ASST" Style="{StaticResource ActiveCyanButton}" Margin="0,0,0,3"/>
                    <Button Content="INSTAGRAF" Style="{StaticResource PillButton}" Margin="0,0,0,3"/>
                    <Button Content="LOAD" Style="{StaticResource PillButton}"/>
                </StackPanel>

                <!-- Column 3: RPM -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="RPM" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <Button Content="RPM : GR" Style="{StaticResource ActiveCyanButton}" Margin="0,0,0,3"/>
                    <Button Content="RPM : ENG" Style="{StaticResource PillButton}" Margin="0,0,0,3"/>
                    <Button Content="RPM : DYNO" Style="{StaticResource PillButton}"/>
                </StackPanel>

                <!-- Column 4: LOAD MODE & TARGET RPM -->
                <Border Grid.Column="3" BorderBrush="#FF2222" BorderThickness="1.2" CornerRadius="8" Background="#120505" Padding="10,4" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="SELECT LOAD MODE" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="MANUAL" Style="{StaticResource PillButton}" Margin="3,0"/>
                            <Button Content="SPEED" Style="{StaticResource ActiveCyanButton}" Margin="3,0"/>
                            <Button Content="ACELLERATION" Style="{StaticResource PillButton}" Margin="3,0"/>
                            <Button Content="2-POINT" Style="{StaticResource PillButton}" Margin="3,0"/>
                        </StackPanel>
                        <!-- Large Touch Target RPM Stepper -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="TARGET RPM" Foreground="#FFFFFF" FontWeight="Black" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="BtnRpmMinus" Content="-" Style="{StaticResource SciFiButton}" Width="34" Height="32" Padding="0" FontSize="18" Click="BtnRpmMinus_Click"/>
                            <Border BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="12" Background="#0C1D26" Padding="18,2" Margin="8,0">
                                <TextBlock x:Name="TxtTargetRpm" Text="7000" Foreground="#FFFFFF" FontWeight="Black" FontSize="18"/>
                            </Border>
                            <Button x:Name="BtnRpmPlus" Content="+" Style="{StaticResource SciFiButton}" Width="34" Height="32" Padding="0" FontSize="18" Click="BtnRpmPlus_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Column 5: Right Action Command Buttons -->
                <StackPanel Grid.Column="4" Width="290">
                    <Border BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="4" Background="#000" Padding="6,2" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtFilePath" Text="C:\Dynomas\SampleDynoRun.CSV" Foreground="#00F0FF" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: Primary Critical Tuner Buttons -->
                        <Button x:Name="BtnRunFile" Grid.Row="0" Grid.Column="0" Content="▶ RUN PULL" Style="{StaticResource RunPullButton}" Margin="2" FontSize="11" Click="BtnRunFile_Click"/>
                        <Button x:Name="BtnTare" Grid.Row="0" Grid.Column="1" Content="TARE ⚖" Style="{StaticResource TareButton}" Margin="2" FontSize="11" Click="BtnTare_Click"/>
                        <Button x:Name="BtnFan" Grid.Row="0" Grid.Column="2" Content="FAN 🌀" Style="{StaticResource FanGreenButton}" Margin="2" FontSize="11" Click="BtnFan_Click"/>

                        <!-- Row 2: Secondary Utility Buttons -->
                        <Button Grid.Row="1" Grid.Column="0" Content="GRAF" Style="{StaticResource SciFiButton}" Margin="2" FontSize="10"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="RATIO" Style="{StaticResource SciFiButton}" Margin="2" FontSize="10"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="ECU/OBD" Style="{StaticResource SciFiButton}" Margin="2" FontSize="10"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ATPS / BENCH DYNO SPEED ANALOG OUTPUT CONTROLLER ================= -->
        <Border Grid.Row="3" Background="#060E14" BorderBrush="#00F0FF" BorderThickness="1.2" CornerRadius="6" Padding="10,5" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Title / Label -->
                    <ColumnDefinition Width="Auto"/> <!-- STOP / IDLE Button -->
                    <ColumnDefinition Width="Auto"/> <!-- Stepper - -->
                    <ColumnDefinition Width="*"/>    <!-- Slider -->
                    <ColumnDefinition Width="Auto"/> <!-- Stepper + -->
                    <ColumnDefinition Width="Auto"/> <!-- Digital Voltage / Pct Readout -->
                    <ColumnDefinition Width="Auto"/> <!-- Preset Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Title / Label -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="⚡ BENCH DYNO SPEED CONTROL" Foreground="#00F0FF" FontWeight="Black" FontSize="11" Effect="{StaticResource CyanSoftGlow}"/>
                    <TextBlock Text="ANALOG OUTPUT / ATPS (0 - 5V)" Foreground="#88A0B0" FontWeight="SemiBold" FontSize="9"/>
                </StackPanel>

                <!-- 0% STOP Button (Safety Red) -->
                <Button x:Name="BtnAtpsZero" Grid.Column="1" Content="⛔ 0% STOP" Background="#2A0808" Foreground="#FF4444" BorderBrush="#FF2222" BorderThickness="1.5" FontWeight="Black" FontSize="11" Height="30" Padding="8,0" Margin="0,0,8,0" Click="BtnAtpsZero_Click" Cursor="Hand"/>

                <!-- Stepper - -->
                <Button x:Name="BtnAtpsMinus" Grid.Column="2" Content="◄ -2%" Style="{StaticResource SciFiButton}" Width="45" Height="30" FontSize="10" Margin="0,0,6,0" Click="BtnAtpsMinus_Click" Cursor="Hand"/>

                <!-- Main Slider (0 - 100%) -->
                <Slider x:Name="SliderAtps" Grid.Column="3" Minimum="0" Maximum="100" Value="0" SmallChange="1" LargeChange="5" Height="26" VerticalAlignment="Center" Margin="6,0" ValueChanged="SliderAtps_ValueChanged" PreviewMouseUp="SliderAtps_MouseUp" Cursor="Hand"/>

                <!-- Stepper + -->
                <Button x:Name="BtnAtpsPlus" Grid.Column="4" Content="+2% ►" Style="{StaticResource SciFiButton}" Width="45" Height="30" FontSize="10" Margin="6,0,10,0" Click="BtnAtpsPlus_Click" Cursor="Hand"/>

                <!-- Digital Readout Badge -->
                <Border Grid.Column="5" BorderBrush="#00FF88" BorderThickness="1.5" CornerRadius="5" Background="#051810" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAtpsVal" Text="0.0% (0.00V)" Foreground="#00FF88" FontWeight="Black" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- Quick Presets -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="20%" Tag="20" Style="{StaticResource SciFiButton}" Width="36" Height="28" FontSize="9.5" Margin="2,0" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                    <Button Content="40%" Tag="40" Style="{StaticResource SciFiButton}" Width="36" Height="28" FontSize="9.5" Margin="2,0" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                    <Button Content="60%" Tag="60" Style="{StaticResource SciFiButton}" Width="36" Height="28" FontSize="9.5" Margin="2,0" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                    <Button Content="80%" Tag="80" Style="{StaticResource SciFiButton}" Width="36" Height="28" FontSize="9.5" Margin="2,0" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                    <Button Content="100%" Tag="100" Style="{StaticResource SciFiButton}" Width="42" Height="28" FontSize="9.5" Margin="2,0" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>