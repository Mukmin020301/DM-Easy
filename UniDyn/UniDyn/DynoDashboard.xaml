<Window x:Class="DynoDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DYNOMAS - Universal Dynamometer Interface"
        Icon="Resources/Uni.ico"
        Width="1280" Height="760" MinWidth="1024" MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        KeyDown="DynoDashboard_KeyDown"
        Background="#000204"
        FontFamily="Segoe UI, Arial">

    <Window.Resources>
        <!-- Crisp Glow Effects -->
        <DropShadowEffect x:Key="CyanGlow" Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="CyanSoftGlow" Color="#00F0FF" BlurRadius="6" ShadowDepth="0" Opacity="0.45"/>
        <DropShadowEffect x:Key="RedGlow" Color="#FF2020" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="YellowGlow" Color="#FFE500" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>

        <!-- Fine Industrial Perforated Dot Pattern -->
        <DrawingBrush x:Key="PerforatedBackground" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#040608">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,14,14"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#000000">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="7,7" RadiusX="2.0" RadiusY="2.0"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0B1216">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="7,7" RadiusX="1.0" RadiusY="1.0"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Base Sci-Fi Button Style -->
        <Style x:Key="DynoButton" TargetType="Button">
            <Setter Property="Background" Value="#03080A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D262C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#66F7FF"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource CyanSoftGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00F0FF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Cyan Filled Button Style -->
        <Style x:Key="ActiveCyanButton" TargetType="Button" BasedOn="{StaticResource DynoButton}">
            <Setter Property="Background" Value="#00F0FF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Effect" Value="{StaticResource CyanSoftGlow}"/>
        </Style>

        <!-- Yellow Border Button Style -->
        <Style x:Key="YellowBorderButton" TargetType="Button" BasedOn="{StaticResource DynoButton}">
            <Setter Property="BorderBrush" Value="#FFE500"/>
            <Setter Property="Background" Value="#0A0902"/>
        </Style>

        <!-- Red Border Button Style -->
        <Style x:Key="RedBorderButton" TargetType="Button" BasedOn="{StaticResource DynoButton}">
            <Setter Property="BorderBrush" Value="#FF2222"/>
            <Setter Property="Background" Value="#0C0303"/>
        </Style>

        <!-- Red Telemetry Border -->
        <Style x:Key="RedTelemetryBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FF2222"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="#0A0202"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <!-- Yellow Telemetry Border -->
        <Style x:Key="YellowTelemetryBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFE500"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="#080802"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <!-- Calibration Input Box Style -->
        <Style x:Key="CalInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#091217"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Calibration Section Header -->
        <Style x:Key="CalFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Compact Calibration Label Style -->
        <Style x:Key="CalLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D6E4EB"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Responsive Viewbox: Automatically fits any screen resolution without clipping -->
    <Viewbox Stretch="Uniform">
        <!-- Outer Perimeter Chamfered Frame (Matches Mockup PNG) -->
        <Border Width="1620" Height="910" Margin="8,6" BorderBrush="#00F0FF" BorderThickness="1.8" CornerRadius="8"
                Background="{StaticResource PerforatedBackground}" SnapsToDevicePixels="True">
        <Grid Margin="10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/> <!-- 0. Top Bar -->
                <RowDefinition Height="*"/>  <!-- 1. Dials + Center Stack -->
                <RowDefinition Height="185"/> <!-- 2. Bottom Control Deck -->
                <RowDefinition Height="42"/> <!-- 3. ATPS Speed Slider -->
            </Grid.RowDefinitions>

            <!-- ================= 0. TOP BAR ================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>

                <!-- Left SETTING Button -->
                <Button x:Name="BtnSetting" Grid.Column="0" Content="SETTING" Style="{StaticResource DynoButton}"
                        Height="32" Width="98" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Click="BtnSetting_Click" ToolTip="Toggle Calibration and Hardware Settings"/>

                <!-- Center: Flanked ENG HP, LOGO, RPM DYNO -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <!-- ENG HP Pill Box -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ENG HP" Foreground="#FF2222" FontSize="11" FontWeight="Black"
                                   FontStyle="Italic" HorizontalAlignment="Center"/>
                        <Border Style="{StaticResource RedTelemetryBox}">
                            <TextBlock x:Name="TxtTopHp" Text="0.0" Foreground="White" FontSize="17"
                                       FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- KZR DYNOMAS OFFICIAL LOGO -->
                    <Image Grid.Column="2" Source="Resources/kzr_logo_dash.png"
                           Height="48" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#00F0FF" BlurRadius="6" ShadowDepth="0" Opacity="0.35"/>
                        </Image.Effect>
                    </Image>

                    <!-- RPM DYNO Pill Box -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="RPM DYNO" Foreground="#FF2222" FontSize="11" FontWeight="Black"
                                   FontStyle="Italic" HorizontalAlignment="Center"/>
                        <Border Style="{StaticResource RedTelemetryBox}">
                            <TextBlock x:Name="TxtTopRpmDyno" Text="0" Foreground="White" FontSize="17"
                                       FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Right Action Buttons: Fullscreen & ON-LINE -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnFullscreen" Content="⛶ FULL" Style="{StaticResource DynoButton}"
                            Height="32" Width="72" Margin="0,0,6,0" Click="BtnFullscreen_Click"
                            ToolTip="Toggle Fullscreen / Windowed mode (or press F11)"/>
                    <Button x:Name="BtnOnline" Content="ON-LINE"
                            Style="{StaticResource ActiveCyanButton}"
                            Height="32" Width="98"
                            Click="BtnOnline_Click" ToolTip="Click to check or reconnect COM4 status"/>
                </StackPanel>
            </Grid>

            <!-- ================= 1. MAIN CLUSTER (LEFT DIAL | CENTER STACK | RIGHT DIAL) ================= -->
            <Grid Grid.Row="1" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/> <!-- Left: RPM Dial (400x400) -->
                    <ColumnDefinition Width="*"/>   <!-- Center: Power Telemetry, AFR, Sensors & Chart -->
                    <ColumnDefinition Width="420"/> <!-- Right: Speed Dial (400x400) -->
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT GAUGE (ENGINE RPM TACHOMETER) ================= -->
                <Grid Grid.Column="0" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Outer Red Accent Ring -->
                    <Ellipse Width="398" Height="398" Stroke="#FF1717" StrokeThickness="1.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Main Cyan Glowing Bezel Ring -->
                    <Ellipse Width="390" Height="390" Stroke="#00F0FF" StrokeThickness="6.5"
                             Effect="{StaticResource CyanGlow}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#001824" Offset="1"/>
                                <GradientStop Color="#02090E" Offset="0.6"/>
                                <GradientStop Color="#000000" Offset="0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Inner Metallic Chamfer -->
                    <Ellipse Width="298" Height="298" Stroke="#24343D" StrokeThickness="3.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Vector Needles & Canvas for Ticks and Numbers -->
                    <Canvas x:Name="CanvasRpmDial" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Tachometer Needle -->
                    <Canvas Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 197,200 L 199,28 L 201,28 L 203,200 Z" Fill="#FFE600"
                              Effect="{StaticResource YellowGlow}">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="RpmNeedleTransform" Angle="-135" CenterX="200" CenterY="200"/>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>

                    <!-- Center Red Carbon Fiber Hub (Layered ON TOP) -->
                    <Grid Width="214" Height="214" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="214" Height="214" Stroke="#FF1717" StrokeThickness="3.8">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#2C0404" Offset="0"/>
                                    <GradientStop Color="#140202" Offset="0.75"/>
                                    <GradientStop Color="#040000" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="200" Height="200" Stroke="#00F0FF" StrokeThickness="1" Opacity="0.45"/>

                        <!-- Digital Readout & Subtitle -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="DYNOMAS" Foreground="#FF2222" FontSize="15" FontWeight="Black"
                                       FontStyle="Italic" HorizontalAlignment="Center" Effect="{StaticResource RedGlow}"/>
                            <TextBlock x:Name="TxtDigitalRpm" Text="0" Foreground="White" FontSize="56"
                                       FontWeight="Black" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                            <TextBlock Text="ENGINE" Foreground="White" FontSize="17" FontWeight="Black"
                                       FontStyle="Italic" HorizontalAlignment="Center"/>
                            <TextBlock Text="- RPM -" Foreground="#DDDDDD" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= CENTER STACK ================= -->
                <Grid Grid.Column="1" Margin="8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/> <!-- Row 0: ENG TORQ | MAX Hp & Nm | LOAD -->
                        <RowDefinition Height="52"/> <!-- Row 1: Dual AFR Meters -->
                        <RowDefinition Height="48"/> <!-- Row 2: 5 Yellow Sensors -->
                        <RowDefinition Height="*"/>  <!-- Row 3: Dyno Graph Curve -->
                        <RowDefinition Height="38"/> <!-- Row 4: YOUR NAME HERE Banner -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: ENG TORQ | MAX (Hp/Nm) | LOAD -->
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ENG TORQ -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ENG TORQ" Foreground="#FF2222" FontSize="10.5" FontWeight="Black"
                                       FontStyle="Italic" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource RedTelemetryBox}">
                                <TextBlock x:Name="TxtTorq" Text="0.0" Foreground="White" FontSize="16"
                                           FontWeight="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- MAX GROUP -->
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="—— MAX ——" Foreground="#FF2222" FontSize="10.5" FontWeight="Black"
                                       FontStyle="Italic" HorizontalAlignment="Center"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource RedTelemetryBox}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Hp " Foreground="#FF5555" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtMaxHp" Text="0.0" Foreground="White" FontSize="15" FontWeight="Black"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource RedTelemetryBox}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Nm " Foreground="#FF5555" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtMaxNm" Text="0.0" Foreground="White" FontSize="15" FontWeight="Black"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- LOAD -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LOAD" Foreground="#FF2222" FontSize="10.5" FontWeight="Black"
                                       FontStyle="Italic" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource RedTelemetryBox}">
                                <TextBlock x:Name="TxtLoad" Text="0" Foreground="White" FontSize="16"
                                           FontWeight="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: DUAL AFR METERS (AFR 1 & AFR 2) -->
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- AFR 1 -->
                        <Border Grid.Column="0" BorderBrush="#00F0FF" BorderThickness="1.4" CornerRadius="6"
                                Background="#021417" Padding="6,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="AFR 1" Foreground="White" FontWeight="Black" FontStyle="Italic" FontSize="12.5"/>
                                <TextBlock x:Name="TxtAfr1" Grid.Column="1" Text="12.8" Foreground="White" FontWeight="Bold" FontSize="13.5"/>
                                <!-- Gradient Bar (Yellow -> Orange -> Red) -->
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="14" CornerRadius="4" Background="#111111" Margin="0,3,0,0">
                                    <Border HorizontalAlignment="Left" Width="145" CornerRadius="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFE500" Offset="0"/>
                                                <GradientStop Color="#FF8800" Offset="0.55"/>
                                                <GradientStop Color="#FF2020" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- AFR 2 -->
                        <Border Grid.Column="2" BorderBrush="#00F0FF" BorderThickness="1.4" CornerRadius="6"
                                Background="#021417" Padding="6,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="AFR 2" Foreground="White" FontWeight="Black" FontStyle="Italic" FontSize="12.5"/>
                                <TextBlock x:Name="TxtAfr2" Grid.Column="1" Text="12.8" Foreground="White" FontWeight="Bold" FontSize="13.5"/>
                                <!-- Gradient Bar (Yellow -> Orange -> Red) -->
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="14" CornerRadius="4" Background="#111111" Margin="0,3,0,0">
                                    <Border HorizontalAlignment="Left" Width="145" CornerRadius="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFE500" Offset="0"/>
                                                <GradientStop Color="#FF8800" Offset="0.55"/>
                                                <GradientStop Color="#FF2020" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 2: FIVE YELLOW SENSOR BOXES (Tps %, Temp c, Iat c, Map kpi, Volt V) -->
                    <Grid Grid.Row="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tps %" Foreground="#FFE500" FontSize="11" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource YellowTelemetryBox}">
                                <TextBlock x:Name="TxtTps" Text="0" Foreground="White" FontSize="15" FontWeight="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Temp c" Foreground="#FFE500" FontSize="11" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource YellowTelemetryBox}">
                                <TextBlock x:Name="TxtTemp" Text="25" Foreground="White" FontSize="15" FontWeight="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Iat c" Foreground="#FFE500" FontSize="11" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource YellowTelemetryBox}">
                                <TextBlock x:Name="TxtIat" Text="48" Foreground="White" FontSize="15" FontWeight="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Map kpi" Foreground="#FFE500" FontSize="11" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource YellowTelemetryBox}">
                                <TextBlock x:Name="TxtMap" Text="57" Foreground="White" FontSize="15" FontWeight="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Volt V" Foreground="#FFE500" FontSize="11" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource YellowTelemetryBox}">
                                <TextBlock x:Name="TxtVolt" Text="13.4" Foreground="White" FontSize="15" FontWeight="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: DYNO GRAPH (HP & TORQUE CURVES) -->
                    <Border Grid.Row="3" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="6"
                            Background="#001418" Margin="0,3,0,1">
                        <Grid x:Name="ChartGrid" ClipToBounds="True">
                            <Canvas x:Name="CanvasChartScale"/>
                            <Polyline x:Name="PolylineHp" Stroke="#00F0FF" StrokeThickness="2.2"/>
                            <Polyline x:Name="PolylineTorque" Stroke="#FF2525" StrokeThickness="2.2"/>
                        </Grid>
                    </Border>

                    <!-- Row 4: YOUR NAME HERE BANNER -->
                    <TextBlock x:Name="TxtBannerTitle" Grid.Row="4" Text="YOUR NAME HERE" Foreground="White" FontSize="26"
                               FontWeight="Black" FontStyle="Italic" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ================= RIGHT GAUGE (SPEED SPEEDOMETER) ================= -->
                <Grid Grid.Column="2" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Outer Red Accent Ring -->
                    <Ellipse Width="398" Height="398" Stroke="#FF1717" StrokeThickness="1.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Main Cyan Glowing Bezel Ring -->
                    <Ellipse Width="390" Height="390" Stroke="#00F0FF" StrokeThickness="6.5"
                             Effect="{StaticResource CyanGlow}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#001824" Offset="1"/>
                                <GradientStop Color="#02090E" Offset="0.6"/>
                                <GradientStop Color="#000000" Offset="0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Inner Metallic Chamfer -->
                    <Ellipse Width="298" Height="298" Stroke="#24343D" StrokeThickness="3.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Vector Needles & Canvas for Ticks and Numbers -->
                    <Canvas x:Name="CanvasSpeedDial" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Speedometer Needle -->
                    <Canvas Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 197,200 L 199,28 L 201,28 L 203,200 Z" Fill="#FFE600"
                              Effect="{StaticResource YellowGlow}">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpeedNeedleTransform" Angle="-135" CenterX="200" CenterY="200"/>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>

                    <!-- Center Red Carbon Fiber Hub (Layered ON TOP) -->
                    <Grid Width="214" Height="214" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="214" Height="214" Stroke="#FF1717" StrokeThickness="3.8">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#2C0404" Offset="0"/>
                                    <GradientStop Color="#140202" Offset="0.75"/>
                                    <GradientStop Color="#040000" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="200" Height="200" Stroke="#00F0FF" StrokeThickness="1" Opacity="0.45"/>

                        <!-- Digital Readout & Subtitle -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="DYNOMAS" Foreground="#FF2222" FontSize="15" FontWeight="Black"
                                       FontStyle="Italic" HorizontalAlignment="Center" Effect="{StaticResource RedGlow}"/>
                            <TextBlock x:Name="TxtDigitalSpeed" Text="0" Foreground="White" FontSize="56"
                                       FontWeight="Black" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                            <TextBlock Text="SPEED" Foreground="White" FontSize="17" FontWeight="Black"
                                       FontStyle="Italic" HorizontalAlignment="Center"/>
                            <TextBlock Text="- KM/H -" Foreground="#DDDDDD" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= 2. BOTTOM CONTROL DECK ================= -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/> <!-- DISPLAY -->
                    <ColumnDefinition Width="155"/> <!-- AUTO -->
                    <ColumnDefinition Width="160"/> <!-- RPM -->
                    <ColumnDefinition Width="*"/>   <!-- SELECT LOAD MODE / TARGET RPM -->
                    <ColumnDefinition Width="460"/> <!-- FILE PATH & ACTIONS -->
                </Grid.ColumnDefinitions>

                <!-- DISPLAY COLUMN -->
                <Grid Grid.Column="0">
                    <StackPanel Margin="2,0,14,0">
                        <TextBlock Text="DISPLAY" Foreground="White" FontSize="12" FontWeight="Black"
                                   FontStyle="Italic" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <Button Content="INERTIA" Style="{StaticResource DynoButton}" Height="34" Margin="0,2"/>
                        <Button Content="LOADED" Style="{StaticResource ActiveCyanButton}" Height="34" Margin="0,2"/>
                    </StackPanel>
                    <Border Width="1.5" Background="#FF2222" HorizontalAlignment="Right" Margin="0,4,0,4"/>
                </Grid>

                <!-- AUTO COLUMN -->
                <Grid Grid.Column="1">
                    <StackPanel Margin="14,0,14,0">
                        <TextBlock Text="AUTO" Foreground="White" FontSize="12" FontWeight="Black"
                                   FontStyle="Italic" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <Button Content="TUNE ASST" Style="{StaticResource ActiveCyanButton}" Height="34" Margin="0,2"/>
                        <Button Content="INSTAGRAF" Style="{StaticResource DynoButton}" Height="34" Margin="0,2"/>
                        <Button Content="LOAD" Style="{StaticResource DynoButton}" Height="34" Margin="0,2"/>
                    </StackPanel>
                    <Border Width="1.5" Background="#FF2222" HorizontalAlignment="Right" Margin="0,4,0,4"/>
                </Grid>

                <!-- RPM COLUMN -->
                <Grid Grid.Column="2">
                    <StackPanel Margin="14,0,14,0">
                        <TextBlock Text="RPM" Foreground="White" FontSize="12" FontWeight="Black"
                                   FontStyle="Italic" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <Button Content="RPM : GR" Style="{StaticResource ActiveCyanButton}" Height="34" Margin="0,2"/>
                        <Button Content="RPM : ENG" Style="{StaticResource DynoButton}" Height="34" Margin="0,2"/>
                        <Button Content="RPM : DYNO" Style="{StaticResource DynoButton}" Height="34" Margin="0,2"/>
                    </StackPanel>
                    <Border Width="1.5" Background="#FF2222" HorizontalAlignment="Right" Margin="0,4,0,4"/>
                </Grid>

                <!-- SELECT LOAD MODE / TARGET RPM (CENTER) -->
                <Grid Grid.Column="3" Margin="14,0,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Red Header Border -->
                    <Border Grid.Row="0" BorderBrush="#FF2222" BorderThickness="1.5" CornerRadius="5" Background="#0C0202">
                        <TextBlock Text="SELECT LOAD MODE" Foreground="White" FontSize="13" FontWeight="Black"
                                   FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="1" BorderBrush="#00F0FF" BorderThickness="1.4" CornerRadius="6"
                            Background="#03080A" Margin="0,5,0,0" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 4 Load Mode Buttons -->
                            <UniformGrid Grid.Row="0" Columns="4">
                                <Button Content="MANUAL" Style="{StaticResource YellowBorderButton}" Margin="3,2"/>
                                <Button Content="SPEED" Style="{StaticResource ActiveCyanButton}" Margin="3,2"/>
                                <Button Content="ACELLERATION" Style="{StaticResource YellowBorderButton}" Margin="3,2"/>
                                <Button Content="2-POINT" Style="{StaticResource YellowBorderButton}" Margin="3,2"/>
                            </UniformGrid>

                            <!-- TARGET RPM - [ 7000 ] + -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="TARGET RPM" Foreground="White" FontSize="19" FontWeight="Black"
                                           FontStyle="Italic" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="BtnRpmMinus" Content="−" Style="{StaticResource RedBorderButton}"
                                        Width="38" Height="38" FontSize="22" Padding="0" Click="BtnRpmMinus_Click"/>
                                <Border BorderBrush="#FF2222" BorderThickness="1.5" CornerRadius="5"
                                        Background="#0A0202" Padding="14,4" Margin="6,0">
                                    <TextBlock x:Name="TxtTargetRpm" Text="7000" Foreground="White" FontSize="24"
                                               FontWeight="Black" VerticalAlignment="Center"/>
                                </Border>
                                <Button x:Name="BtnRpmPlus" Content="+" Style="{StaticResource RedBorderButton}"
                                        Width="38" Height="38" FontSize="22" Padding="0" Click="BtnRpmPlus_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- FILE PATH & 8 ACTION BUTTONS (RIGHT) -->
                <Grid Grid.Column="4" Margin="2,0,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Path Box -->
                    <Border Grid.Row="0" BorderBrush="#00F0FF" BorderThickness="1.4" CornerRadius="5"
                            Background="#03090B" Padding="10,3">
                        <TextBlock x:Name="TxtFilePath" Text="C:\Data\New folder (2)\Run" Foreground="White"
                                   FontSize="13" FontWeight="Bold" FontStyle="Italic" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- 3x3 Button Grid -->
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Button x:Name="BtnRunFile" Grid.Row="0" Grid.Column="0" Content="RUN FILE"
                                Style="{StaticResource DynoButton}" Margin="3,2" Click="BtnRunFile_Click"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="GRAF" Style="{StaticResource DynoButton}" Margin="3,2"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="ECU / OBD" Style="{StaticResource DynoButton}" Margin="3,2"/>

                        <Button Grid.Row="1" Grid.Column="0" Content="RATIO" Style="{StaticResource DynoButton}" Margin="3,2"/>
                        <Button x:Name="BtnTare" Grid.Row="1" Grid.Column="1" Content="TARE"
                                Style="{StaticResource DynoButton}" Margin="3,2" Click="BtnTare_Click"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="RPM-1" Style="{StaticResource DynoButton}" Margin="3,2"/>

                        <Button Grid.Row="2" Grid.Column="0" Content="RUN: 1" Style="{StaticResource DynoButton}" Margin="3,2"/>
                        <Button x:Name="BtnFan" Grid.Row="2" Grid.Column="1" Content="FAN CONTROL"
                                Style="{StaticResource DynoButton}" Margin="3,2" Click="BtnFan_Click"/>
                        <Button x:Name="BtnCalibrationsBottom" Grid.Row="2" Grid.Column="2" Content="CALIBRATIONS"
                                Style="{StaticResource DynoButton}" Margin="3,2" Click="BtnSetting_Click"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= 3. BENCH DYNO SPEED CONTROL (ATPS) ================= -->
            <Border Grid.Row="3" Background="#03080A" BorderBrush="#00F0FF" BorderThickness="1.2"
                    CornerRadius="5" Padding="8,2" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="BENCH DYNO SPEED CONTROL" Foreground="#00F0FF" FontSize="11" FontWeight="Black"/>
                        <TextBlock Text="ANALOG OUTPUT / ATPS (0 - 5V)" Foreground="#88A0A8" FontSize="9"/>
                    </StackPanel>

                    <Button x:Name="BtnAtpsZero" Grid.Column="1" Content="0% STOP"
                            Background="#260404" Foreground="#FF3333" BorderBrush="#FF2222"
                            BorderThickness="1.4" FontWeight="Black" FontSize="11" Margin="2"
                            Click="BtnAtpsZero_Click" Cursor="Hand"/>

                    <Button x:Name="BtnAtpsMinus" Grid.Column="2" Content="-2%"
                            Style="{StaticResource DynoButton}" Margin="2" Click="BtnAtpsMinus_Click"/>

                    <Slider x:Name="SliderAtps" Grid.Column="3" Minimum="0" Maximum="100" Value="0"
                            SmallChange="1" LargeChange="5" Height="22" VerticalAlignment="Center"
                            Margin="8,0" ValueChanged="SliderAtps_ValueChanged"
                            PreviewMouseUp="SliderAtps_MouseUp" Cursor="Hand"/>

                    <Button x:Name="BtnAtpsPlus" Grid.Column="4" Content="+2%"
                            Style="{StaticResource DynoButton}" Margin="2" Click="BtnAtpsPlus_Click"/>

                    <Border Grid.Column="5" BorderBrush="#00FF88" BorderThickness="1.2"
                            Background="#02140A" CornerRadius="4" Padding="6,2" Margin="3">
                        <TextBlock x:Name="TxtAtpsVal" Text="0.0% (0.00V)" Foreground="#00FF88"
                                   FontWeight="Black" FontSize="12" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <UniformGrid Grid.Column="6" Columns="5">
                        <Button Content="20%" Tag="20" Style="{StaticResource DynoButton}" FontSize="10" Margin="1" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                        <Button Content="40%" Tag="40" Style="{StaticResource DynoButton}" FontSize="10" Margin="1" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                        <Button Content="60%" Tag="60" Style="{StaticResource DynoButton}" FontSize="10" Margin="1" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                        <Button Content="80%" Tag="80" Style="{StaticResource DynoButton}" FontSize="10" Margin="1" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                        <Button Content="100%" Tag="100" Style="{StaticResource DynoButton}" FontSize="10" Margin="1" Click="BtnAtpsPreset_Click" Cursor="Hand"/>
                    </UniformGrid>
                </Grid>
            </Border>
            <!-- ================= CALIBRATION MODAL OVERLAY (1:1 Mirrored Legacy Layout with Modern Dark Styling) ================= -->
            <Grid x:Name="ModalCalOverlay" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed"
                  Background="#E6010305" Panel.ZIndex="1000">
                <Border Width="980" VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="#00F0FF" BorderThickness="2" CornerRadius="10"
                        Background="#080E14" Effect="{StaticResource CyanGlow}" Padding="16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 0: Title Bar -->
                            <RowDefinition Height="Auto"/> <!-- 1: Title Input -->
                            <RowDefinition Height="Auto"/> <!-- 2: Shop Name & Contact -->
                            <RowDefinition Height="Auto"/> <!-- 3: 3-Col Dyno Specs / Inertia / Limits -->
                            <RowDefinition Height="Auto"/> <!-- 4: SAE Weather Strip -->
                            <RowDefinition Height="Auto"/> <!-- 5: Braking & Controller Hardware -->
                            <RowDefinition Height="Auto"/> <!-- 6: Sensor Channel Scaling & Alarms -->
                            <RowDefinition Height="Auto"/> <!-- 7: Footer Actions & Color Settings -->
                        </Grid.RowDefinitions>

                        <!-- Title Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Dynamometer and Vehicle Calibrations" Foreground="#00F0FF"
                                       FontSize="15" FontWeight="Black" VerticalAlignment="Center"/>
                            <Button x:Name="BtnCloseModal" Content="&#x2715;" Style="{StaticResource RedBorderButton}"
                                    Width="26" Height="26" FontSize="13" Padding="0" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="BtnCloseModal_Click" ToolTip="Close without saving"/>
                        </Grid>

                        <!-- Row 1: Title -->
                        <Grid Grid.Row="1" Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Title" Style="{StaticResource CalLabel}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCalTitle" Grid.Column="1" Style="{StaticResource CalInputBox}" Margin="0" Height="28"/>
                        </Grid>

                        <!-- Row 2: Shop Name & Contact -->
                        <Grid Grid.Row="2" Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Shop Name:" Style="{StaticResource CalLabel}" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtCalShopName" Style="{StaticResource CalInputBox}" Height="28"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Contact:" Style="{StaticResource CalLabel}" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtCalContact" Style="{StaticResource CalInputBox}" Height="28"/>
                            </DockPanel>
                        </Grid>

                        <!-- Row 3: 3-Col Dyno Specs / Inertia / Machine Limits -->
                        <Grid Grid.Row="3" Margin="0,3,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.05*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Col 1: Roller Diam & Mechanical Friction -->
                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Roller Diam -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="Roller Diam (m)" Style="{StaticResource CalLabel}" Width="110"/>
                                    <TextBox x:Name="TxtCalRollerDiam" Width="72" Height="28" Style="{StaticResource CalInputBox}" Margin="0"/>
                                </StackPanel>

                                <!-- Friction Group with Curly Brace and Auto button -->
                                <Grid Grid.Row="1" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                            <TextBlock Text="Frict. Offset (Nm)" Style="{StaticResource CalLabel}" Width="110"/>
                                            <TextBox x:Name="TxtCalFrictOfs" Width="72" Height="28" Style="{StaticResource CalInputBox}" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                            <TextBlock Text="Factor (Nm/rpm)" Style="{StaticResource CalLabel}" Width="110"/>
                                            <TextBox x:Name="TxtCalFrictFact" Width="72" Height="28" Style="{StaticResource CalInputBox}" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                            <TextBlock Text="Quad (Nm/rpm²)" Style="{StaticResource CalLabel}" Width="110"/>
                                            <TextBox x:Name="TxtCalFrictQuad" Width="72" Height="28" Style="{StaticResource CalInputBox}" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Curly Brace -->
                                    <TextBlock Grid.Column="1" Text="&#125;" Foreground="#00F0FF" FontSize="44" FontWeight="ExtraLight"
                                               VerticalAlignment="Center" Margin="3,-6,3,0"/>

                                    <!-- Auto Button -->
                                    <Button x:Name="BtnAutoFrictWpf" Grid.Column="2" Content="Auto" Width="48" Height="28"
                                            Style="{StaticResource YellowBorderButton}" VerticalAlignment="Center"
                                            Click="BtnAutoFrictWpf_Click" ToolTip="Automated coast-down friction calculation"/>
                                </Grid>

                                <!-- DT and Km -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="110,2,0,0">
                                    <TextBlock Text="DT:" Foreground="#88A0A8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtCalKm" Text="Km: 0.0" Foreground="#00F0FF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Col 2: Machine Limits & Dyno Type -->
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="Dyno Type" Style="{StaticResource CalLabel}" Width="130"/>
                                    <TextBox x:Name="TxtCalDynoType" Width="105" Height="28" Style="{StaticResource CalInputBox}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                    <TextBlock Text="Max RPM" Style="{StaticResource CalLabel}" Width="130"/>
                                    <TextBox x:Name="TxtCalMaxRpm" Width="75" Height="28" Style="{StaticResource CalInputBox}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                    <TextBlock Text="Max Torque (Nm)" Style="{StaticResource CalLabel}" Width="130"/>
                                    <TextBox x:Name="TxtCalMaxTorq" Width="75" Height="28" Style="{StaticResource CalInputBox}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                    <TextBlock Text="Acelleration Control (%/sec)" Style="{StaticResource CalLabel}" Width="140"/>
                                    <TextBox x:Name="TxtCalAcelCtrl" Width="65" Height="28" Style="{StaticResource CalInputBox}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 3: Inertia & Drive Ratio -->
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="Dynamometer Inertia (kg m²)" Style="{StaticResource CalLabel}" Width="150"/>
                                    <TextBox x:Name="TxtCalDynoInert" Width="75" Height="28" Style="{StaticResource CalInputBox}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                    <TextBlock Text="Equiv Engine Inertia:" Style="{StaticResource CalLabel}" Width="150"/>
                                    <Border BorderBrush="#FFE500" BorderThickness="1" CornerRadius="3" Background="#141400"
                                            Padding="4,2" Width="75" Height="28">
                                        <TextBlock x:Name="TxtCalEquivInert" Text="0.000" Foreground="#FFE500" FontWeight="Black"
                                                   FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                    <TextBlock Text="Engine Inertia" Style="{StaticResource CalLabel}" Width="150"/>
                                    <TextBox x:Name="TxtCalEngInert" Width="75" Height="28" Style="{StaticResource CalInputBox}" Margin="0"
                                             TextChanged="TxtCalEngInert_TextChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                    <TextBlock Text="Gear Ratio" Style="{StaticResource CalLabel}" Width="150"/>
                                    <TextBox x:Name="TxtCalGearRatio" Width="75" Height="28" Style="{StaticResource CalInputBox}" Margin="0"
                                             TextChanged="TxtCalGearRatio_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: SAE Atmospheric Correction Strip -->
                        <Border Grid.Row="4" Background="#0A1218" BorderBrush="#16323F" BorderThickness="1.2"
                                CornerRadius="5" Padding="10,4" Margin="0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkUseSae" Content="Use SAE Correction:" Foreground="White"
                                          FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Click="ChkUseSae_Click"/>
                                <Border BorderBrush="#00FF88" BorderThickness="1.2" Background="#02150B" CornerRadius="3"
                                        Padding="6,2" Margin="8,0,16,0" VerticalAlignment="Center" Height="28">
                                    <TextBlock x:Name="TxtSaeCf" Text="100%" Foreground="#00FF88" FontWeight="Black" FontSize="12.5"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Pres (kPa)" Style="{StaticResource CalLabel}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSaePress" Width="60" Height="28" Style="{StaticResource CalInputBox}" Margin="0,0,14,0" TextChanged="TxtSae_TextChanged"/>

                                <TextBlock Text="Temp (C)" Style="{StaticResource CalLabel}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSaeTemp" Width="55" Height="28" Style="{StaticResource CalInputBox}" Margin="0,0,14,0" TextChanged="TxtSae_TextChanged"/>

                                <TextBlock Text="RH (%)" Style="{StaticResource CalLabel}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSaeRh" Width="55" Height="28" Style="{StaticResource CalInputBox}" Margin="0,0,20,0"/>

                                <CheckBox x:Name="ChkSaeAuto" Content="Get Data from Weather Station" Foreground="White"
                                          FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Row 5: Braking Controls & Controller Hardware -->
                        <Grid Grid.Row="5" Margin="0,3,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Braking Explanation -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Braking Controls:" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Foreground="#95A8B0" FontSize="10.5" LineHeight="14" TextWrapping="Wrap"
                                           Text="Breaking can be ramped down or continous&#x0a;Using a constant, or the 2-Point Stop load%&#x0a;and continue to 0 rpm, or the start speed"/>
                            </StackPanel>

                            <!-- Center: Braking Settings -->
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox x:Name="ChkRemoteBrake" Content="Remote Brake/Load on Analog Channel: " Foreground="White"
                                              FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtRemoteChannel" Width="44" Height="28" Style="{StaticResource CalInputBox}" Margin="4,0,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <RadioButton x:Name="RadBrakeLoad" Content="Load: " Foreground="White" FontSize="11.5"
                                                 FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtBrakeLoadVal" Width="44" Height="28" Style="{StaticResource CalInputBox}" Margin="4,0,4,0"/>
                                    <TextBlock Text="%" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <CheckBox x:Name="ChkRampDown" Content="Ramp Down" Foreground="White" FontSize="11.5"
                                              FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <RadioButton x:Name="RadBrake2Point" Content="Use Stop Load %" Foreground="White" FontSize="11.5"
                                                 FontWeight="SemiBold" VerticalAlignment="Center" Width="125"/>
                                    <CheckBox x:Name="ChkCutoffStart" Content="Cutoff at Start RPM" Foreground="White" FontSize="11.5"
                                              FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Controller Cals -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <Button x:Name="BtnContCalsWpf" Content="Controller Cals" Style="{StaticResource DynoButton}"
                                        Width="135" Height="28" Click="BtnContCalsWpf_Click"/>
                                <TextBlock Foreground="#95A8B0" FontSize="10" Margin="0,2,0,0" TextAlignment="Center" LineHeight="13"
                                           Text="You can change controller&#x0a;cals like Torque Calibration&#x0a;Speed Pulses per Rev and&#x0a;PID and Alamr Limits"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 6: Sensor Channels (12-Columns) -->
                        <Border Grid.Row="6" Background="#060C10" BorderBrush="#142C38" BorderThickness="1.2"
                                CornerRadius="6" Padding="8,5" Margin="0,2,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- ComboBox & Header text -->
                                    <RowDefinition Height="Auto"/> <!-- 12 column labels -->
                                    <RowDefinition Height="Auto"/> <!-- 12 textboxes -->
                                    <RowDefinition Height="Auto"/> <!-- Subtitle explanation -->
                                </Grid.RowDefinitions>

                                <!-- ComboBox and Section Titles -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbChannels" Height="28" Background="#091217" Foreground="#000000"
                                              FontSize="11.5" FontWeight="Bold" SelectionChanged="CmbChannels_SelectionChanged"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="-10,0,0,0">
                                        <TextBlock Text="Channel Names, Scaling, Alarms, Filtering, Gage Ticks and Decimal Points"
                                                   Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Min, Max and Alarm Level 1 and 2" Foreground="#88A0A8"
                                                   FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 12 Column Labels -->
                                <Grid Grid.Row="1" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>  <!-- Name -->
                                        <ColumnDefinition Width="0.95*"/> <!-- Units -->
                                        <ColumnDefinition Width="0.85*"/> <!-- Offset -->
                                        <ColumnDefinition Width="0.95*"/> <!-- Factor -->
                                        <ColumnDefinition Width="0.85*"/> <!-- Min -->
                                        <ColumnDefinition Width="0.95*"/> <!-- A 1 -->
                                        <ColumnDefinition Width="0.95*"/> <!-- A 2 -->
                                        <ColumnDefinition Width="0.95*"/> <!-- Max -->
                                        <ColumnDefinition Width="0.85*"/> <!-- Filter -->
                                        <ColumnDefinition Width="0.95*"/> <!-- Major Tix -->
                                        <ColumnDefinition Width="0.95*"/> <!-- Minor Tix -->
                                        <ColumnDefinition Width="0.85*"/> <!-- Decimal -->
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="Units" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="Offset" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="Factor" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="4" Text="Min" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="5" Text="A 1" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="6" Text="A 2" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="Max" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="8" Text="Filter" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="9" Text="Major Tix" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="10" Text="Minor Tix" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="11" Text="Decimal" Style="{StaticResource CalLabel}" HorizontalAlignment="Center" FontSize="11"/>
                                </Grid>

                                <!-- 12 Input Boxes -->
                                <Grid Grid.Row="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                        <ColumnDefinition Width="0.85*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                        <ColumnDefinition Width="0.85*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                        <ColumnDefinition Width="0.85*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                        <ColumnDefinition Width="0.85*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtChName" Grid.Column="0" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="3,1" FontSize="11.5"/>
                                    <TextBox x:Name="TxtChUnits" Grid.Column="1" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChOffset" Grid.Column="2" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChFactor" Grid.Column="3" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChMin" Grid.Column="4" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChA1" Grid.Column="5" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChA2" Grid.Column="6" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChMax" Grid.Column="7" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChFilter" Grid.Column="8" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChMajorTicks" Grid.Column="9" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChMinorTicks" Grid.Column="10" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                    <TextBox x:Name="TxtChDecimals" Grid.Column="11" Style="{StaticResource CalInputBox}" Margin="2,0" Height="28" Padding="2,1" FontSize="11.5" TextAlignment="Center"/>
                                </Grid>

                                <!-- Subtitles: Formulas & Hints -->
                                <Grid Grid.Row="3">
                                    <TextBlock Text="Displayed value = Measured x Factor + Offser" Foreground="#88A0A8"
                                               FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                                    <TextBlock Text="Filter: 0 No Filter, 0.99 = Heavy Filter" Foreground="#88A0A8"
                                               FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Row 7: Footer Actions & Color Settings -->
                        <Grid Grid.Row="7" Margin="0,4,0,0">
                            <Button x:Name="BtnSaveCal" Content="Set Calibrations" Style="{StaticResource ActiveCyanButton}"
                                    Width="140" Height="32" HorizontalAlignment="Left" Click="BtnSaveCal_Click"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Screen Magnification (for jpg)" Style="{StaticResource CalLabel}" Margin="0,0,6,0" FontSize="11.5"/>
                                <TextBox x:Name="TxtCalMag" Width="50" Height="28" Style="{StaticResource CalInputBox}" Margin="0,0,16,0" TextAlignment="Center"/>

                                <Button x:Name="BtnSkinColor" Content="Skin Color" Style="{StaticResource DynoButton}"
                                        Width="95" Height="28" Margin="0,0,8,0" Click="BtnSkinColor_Click"/>
                                <Button x:Name="BtnBgColor" Content="Background Color" Style="{StaticResource DynoButton}"
                                        Width="125" Height="28" Click="BtnBgColor_Click"/>
                            </StackPanel>

                            <Button x:Name="BtnCancelCal" Content="Cancel" Style="{StaticResource RedBorderButton}"
                                    Width="90" Height="32" HorizontalAlignment="Right" Click="BtnCancelCal_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Viewbox>
</Window>